default_platform(:ios)

# ─── Helpers ─────────────────────────────────────────────────────────────────

def flutter_build_number
  # Use the GitHub Actions run number when available, otherwise timestamp
  ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M")
end

def app_store_api_key
  app_store_connect_api_key(
    key_id:        ENV["APP_STORE_CONNECT_API_KEY_ID"],
    issuer_id:     ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_content:   ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
    is_key_content_base64: true,
    in_house:      false,
  )
end

# ─── iOS ─────────────────────────────────────────────────────────────────────

platform :ios do

  desc "Sync certificates and profiles via Match (read-only in CI)"
  lane :certificates do
    setup_ci if ENV["CI"]
    api_key = app_store_api_key
    match(
      type:       "appstore",
      readonly:   is_ci,
      git_url:    ENV["MATCH_GIT_URL"],
      password:   ENV["MATCH_PASSWORD"],
      api_key:    api_key,
      app_identifier: "com.projectmgmt.app",
    )
  end

  desc "Run Flutter unit & widget tests"
  lane :test do
    sh("flutter test --coverage", chdir: "../")
  end

  desc "Build and upload a new beta build to TestFlight"
  lane :beta do
    build_number = flutter_build_number
    api_key      = app_store_api_key

    # Ensure signing is in place
    certificates

    # Increment build number in Info.plist
    increment_build_number(
      build_number: build_number,
      xcodeproj:    "ios/Runner.xcodeproj",
    )

    # Build the Flutter IPA
    sh(
      "flutter build ipa --release --build-number=#{build_number} --export-options-plist=ios/ExportOptions.plist",
      chdir: "../",
    )

    # Upload to TestFlight
    upload_to_testflight(
      ipa:                              "build/ios/ipa/project_management.ipa",
      api_key:                          api_key,
      skip_waiting_for_build_processing: true,
      changelog:                        ENV.fetch("RELEASE_NOTES", "Bug fixes and improvements"),
    )

    # Tag the release in git
    add_git_tag(
      tag: "ios/#{get_version_number(xcodeproj: 'ios/Runner.xcodeproj')}-#{build_number}",
    )
    push_git_tags
  end

  desc "Promote the latest TestFlight build to App Store"
  lane :release do
    api_key = app_store_api_key
    deliver(
      api_key:               api_key,
      submit_for_review:     true,
      automatic_release:     false,
      skip_metadata:         true,
      skip_screenshots:      true,
      precheck_include_in_app_purchases: false,
    )
  end

end

# ─── Android ─────────────────────────────────────────────────────────────────

platform :android do

  desc "Run Flutter unit tests"
  lane :test do
    sh("flutter test --coverage", chdir: "../")
  end

  desc "Build a signed AAB and upload to Play Store Internal Testing"
  lane :internal do
    build_number = flutter_build_number

    # Build the Flutter AAB
    sh(
      "flutter build appbundle --release --build-number=#{build_number}",
      chdir: "../",
    )

    # Sign and upload via supply
    upload_to_play_store(
      track:                    "internal",
      aab:                      "../build/app/outputs/bundle/release/app-release.aab",
      json_key_data:            ENV["GOOGLE_PLAY_JSON_KEY"],
      skip_upload_apk:          true,
      skip_upload_metadata:     true,
      skip_upload_images:       true,
      skip_upload_screenshots:  true,
      version_code:             build_number.to_i,
      release_status:           "draft",
    )

    # Tag the release
    add_git_tag(tag: "android/#{build_number}")
    push_git_tags
  end

  desc "Promote build from Internal to Production on Play Store"
  lane :promote do
    upload_to_play_store(
      track:                  "internal",
      track_promote_to:       "production",
      json_key_data:          ENV["GOOGLE_PLAY_JSON_KEY"],
      skip_upload_apk:        true,
      skip_upload_aab:        true,
      skip_upload_metadata:   true,
      skip_upload_images:     true,
      skip_upload_screenshots: true,
    )
  end

end
