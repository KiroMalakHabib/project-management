# ─── Apple / iOS ──────────────────────────────────────────────────────────────

# Apple ID (email) used for App Store Connect
APPLE_ID=you@example.com

# App Store Connect team IDs (find in App Store Connect → Membership)
ITC_TEAM_ID=123456789
TEAM_ID=ABCDE12345

# App Store Connect API Key (create in Users & Access → Integrations → API Keys)
# Key ID shown in the API Keys list
APP_STORE_CONNECT_API_KEY_ID=XXXXXXXXXX
# Issuer ID shown at the top of the API Keys page
APP_STORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Contents of the .p8 key file, base64-encoded:
#   base64 -i AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
APP_STORE_CONNECT_API_KEY_CONTENT=LS0tLS1CRUdJTi...

# fastlane match — private git repo that stores encrypted certificates/profiles
# e.g. git@github.com:your-org/certificates.git
MATCH_GIT_URL=git@github.com:your-org/mobile-certificates.git
# Passphrase used to encrypt/decrypt the repo
MATCH_PASSWORD=super-secret-passphrase

# ─── Android / Google Play ────────────────────────────────────────────────────

# Service account JSON key for Google Play API (full JSON contents as a single line)
# Create in Google Play Console → Setup → API access → Service accounts
GOOGLE_PLAY_JSON_KEY={"type":"service_account","project_id":"..."}

# Android signing keystore (for local builds; in CI the keystore is decoded from
# the ANDROID_KEYSTORE_BASE64 GitHub secret and written to android/app/keystore.jks)
ANDROID_STORE_PASSWORD=your-keystore-password
ANDROID_KEY_ALIAS=your-key-alias
ANDROID_KEY_PASSWORD=your-key-password

# ─── Optional ─────────────────────────────────────────────────────────────────

# Release notes shown in TestFlight / Play Store Internal Testing
RELEASE_NOTES=Bug fixes and improvements

# Set automatically by GitHub Actions (used as build number)
# GITHUB_RUN_NUMBER=42
