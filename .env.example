# ========================
# Application
# ========================
NODE_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000

# ========================
# Database
# ========================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=projectmgmt
DATABASE_USER=pguser
DATABASE_PASSWORD=pgpassword
DATABASE_URL=postgres://pguser:pgpassword@localhost:5432/projectmgmt

# ========================
# Redis
# ========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ========================
# JWT
# ========================
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRY=7d
JWT_INVITE_SECRET=your-super-secret-invite-key-change-in-production
JWT_INVITE_EXPIRY=48h

# ========================
# Storage (S3 / MinIO)
# ========================
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=attachments
S3_PUBLIC_URL=http://localhost:9000/attachments

# ========================
# Frontend
# ========================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=ws://localhost:4000/graphql

# ========================
# Email (for invites)
# ========================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-mailtrap-user
SMTP_PASSWORD=your-mailtrap-password
SMTP_FROM=noreply@projectmgmt.app
